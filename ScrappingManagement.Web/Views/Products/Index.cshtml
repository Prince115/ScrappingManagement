@model ScrappingManagement.Web.Dto.PaginatedList<ScrappingManagement.Web.Models.Product>


@{
    ViewData["Title"] = "Products";
    var currentPageSize = ViewData["CurrentPageSize"] as int? ?? 10;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Products</h2>
    <p class="mb-0">
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="form-actions no-color">
        <p>
            Find by name: <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" />
            <button type="submit" class="btn btn-info">Filter</button> |
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </p>
    </div>
    <div class="mb-3">
        <label for="pageSize" class="form-label me-2">Show:</label>
        <select name="pageSize" id="pageSize" class="form-select form-select-sm auto-submit" style="width: auto; display: inline-block;">
            <option value="5" selected="@(currentPageSize == 5)">5</option>
            <option value="10" selected="@(currentPageSize == 10)">10</option>
            <option value="20" selected="@(currentPageSize == 20)">20</option>
            <option value="50" selected="@(currentPageSize == 50)">50</option>
        </select>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Rate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>


@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    var currentFilter = ViewData["CurrentFilter"];
    int current = Model.PageIndex;
    int total = Model.TotalPages;
    var pagesSet = new System.Collections.Generic.SortedSet<int>();
    for (int i = 1; i <= Math.Min(3, total); i++) pagesSet.Add(i);
    for (int i = Math.Max(1, current - 2); i <= Math.Min(total, current + 2); i++) pagesSet.Add(i);
    for (int i = Math.Max(1, total - 2); i <= total; i++) pagesSet.Add(i);
    var pageList = pagesSet.ToList();
}
<div class="d-flex justify-content-center mt-3">
    <nav aria-label="Quotes pagination">
        <ul class="pagination">
            <li class="page-item @(current <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@(current - 1)"
                   asp-route-searchString="@currentFilter"
                   asp-route-pageSize="@currentPageSize">Previous</a>
            </li>

            @{
                for (int i = 0; i < pageList.Count; i++)
                {
                    var p = pageList[i];
                    var isActive = p == current;
                    <li class="page-item @(isActive ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@p"
                           asp-route-searchString="@currentFilter"
                           asp-route-pageSize="@currentPageSize">@p</a>
                    </li>
                    ;

                    if (i < pageList.Count - 1 && pageList[i + 1] > p + 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                        ;
                    }
                }
            }

            <li class="page-item @(current >= total ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@(current + 1)"
                   asp-route-searchString="@currentFilter"
                   asp-route-pageSize="@currentPageSize">Next</a>
            </li>

            <li class="page-item d-flex align-items-center ms-3">
                <label for="pageSize" class="form-label mb-0 me-2">Show:</label>
                <select name="pageSize" id="pageSize" class="form-select form-select-sm auto-submit" style="width: auto;">
                    <option value="5" selected="@(ViewData["CurrentPageSize"]?.ToString() == "5")">5</option>
                    <option value="10" selected="@(ViewData["CurrentPageSize"]?.ToString() == "10")">10</option>
                    <option value="20" selected="@(ViewData["CurrentPageSize"]?.ToString() == "20")">20</option>
                    <option value="50" selected="@(ViewData["CurrentPageSize"]?.ToString() == "50")">50</option>
                </select>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#pageSize').change(function () {
                $(this).closest('form').submit();
            });
        });
    </script>
}