@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Scrapping Management</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/ScrappingManagement.Web.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/responsive-tables.css" asp-append-version="true" />
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
	<script>
			(function () {
				let theme = localStorage.getItem('theme');
				if (!theme) {
					theme = 'light';
					localStorage.setItem('theme', theme);
				}
				document.documentElement.setAttribute('data-bs-theme', theme);
				window.currentTheme = theme;
			})();
	</script>
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Dashboard">Scrapping Management</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav flex-grow-1">
						@if (SignInManager.IsSignedIn(User) && (User.IsInRole("Admin") || User.IsInRole("User")))
						{
							<li class="nav-item">
								<a class="nav-link" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Suppliers" asp-action="Index">Suppliers</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Customers" asp-action="Index">Customers</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">Products</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Quotes" asp-action="Index">Quotes</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-area="" asp-controller="Payments" asp-action="Index">Payments</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-controller="Invoices" asp-action="Index">Invoices</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-controller="Receipts" asp-action="Index">Receipts</a>
							</li>
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									Ledger
								</a>
								<ul class="dropdown-menu" aria-labelledby="quotesDropdown">
									<li><a class="dropdown-item" asp-controller="CustomerLedger" asp-action="Index">Cusomer Ledger</a></li>
									<li><a class="dropdown-item" asp-controller="SupplierLedger" asp-action="Index">Supplier Ledger</a></li>
								</ul>
							</li>
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									Reports
								</a>
								<ul class="dropdown-menu" aria-labelledby="quotesDropdown">
									<li><a class="dropdown-item" asp-controller="Report" asp-action="CustomerItems">Cusomer Items</a></li>
								</ul>
							</li>
						}
					</ul>
                  
					<div class="d-flex align-items-center gap-2 ms-auto">
						<span class="text-muted small">
							<i class="bi bi-sun"></i>
						</span>
						<label class="theme-toggle" title="Toggle dark mode">
							<input type="checkbox" id="themeToggle">
							<span class="theme-slider"></span>
						</label>
						<span class="text-muted small">
							<i class="bi bi-moon"></i>
						</span>
					</div>

					<partial name="_LoginPartial" />
				</div>
			</div>
		</nav>
	</header>
	<div class="container">
		<main role="main" class="pb-3" style="margin-bottom: 60px !important;">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; @DateTime.Now.Year - Ambit Infoway - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>