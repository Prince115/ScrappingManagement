@using ScrappingManagement.Web.Dto
@model InvoiceViewModel

@{
    ViewData["Title"] = "Create Invoice";
}

<h2>Create Invoice</h2>

<form asp-action="Create" method="post">
    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="CustomerId" class="form-label">Customer</label>
            <select asp-for="CustomerId" class="form-select" required>
                <option value="">-- Select Customer --</option>
                @foreach (var supplier in Model.Customers)
                {
                    <option value="@supplier.Value">@supplier.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Location" class="form-label">Location</label>
            <input asp-for="Location" class="form-control" id="Location" />
        </div>

        <div class="col-md-3">
            <label asp-for="Date" class="form-label">Date</label>
            <input asp-for="Date" type="date" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="InvoiceNumber" class="form-label">Invoice Number</label>
            <input asp-for="InvoiceNumber" readonly class="form-control" />
        </div>
        <div class="form-check col-md-3">
            <input asp-for="WithGst" class="form-check-input" type="checkbox" id="withGstCheckbox" />
            <label class="form-check-label" for="withGstCheckbox">With GST</label>
        </div>
        <div class="col-md-3">
            <label asp-for="BookNo" class="form-label">Book Number</label>
            <input asp-for="BookNo" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="BillNo" class="form-label">Bill Number</label>
            <input asp-for="BillNo" class="form-control" />
        </div>
       
    </div>

    <h4>Products</h4>

    <table class="table table-bordered" id="productTable">
        <thead>
            <tr>
                <th>NO</th>
                <th>Product</th>
                <th>Weight</th>
                <th>Rate</th>
                <th>Amount</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="productTableBody">
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>
                        @Html.DropDownListFor(model => model.Items[i].ProductId, Model.Products, "Select Product", new { @class = "form-control product-select" })
                    </td>
                    <td>
                        <input type="number" step="0.01" name="Items[@i].Weight" class="form-control weight" value="@Model.Items[i].Weight" />
                    </td>
                    <td>
                        <input type="number" step="0.01" name="Items[@i].Rate" class="form-control rate" value="@Model.Items[i].Rate" />
                    </td>
                    <td>
                        <input type="text" class="form-control amount" name="Items[@i].Amount" value="@Model.Items[i].Amount" readonly />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2" class="text-end">Total</td>
                <td id="totalWeight">0</td>
                <td></td>
                <td id="totalAmount">0</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <button type="button" class="btn btn-secondary mb-3" onclick="addProductRow()">Add Product</button>

    <div class="row">
        <div class="col-sm-6">
            <label>Note</label>
            <textarea asp-for="Note" class="form-control"></textarea>
        </div>

        <div class="col-sm-6">
            <div class="row justify-content-end">
                <div class="col-md-3">
                    <label>Extra</label>
                    <input asp-for="PackagingCharge" id="packagingCharge" type="number" step="0.01" class="form-control" value="@Model.PackagingCharge" />
                </div>
                <div class="row justify-content-end">
                    <div class="col-md-3 gst-field">
                        <label>GST %</label>
                        <input asp-for="GstPercentage" id="gstPercentage" type="number" step="0.01" class="form-control" value="@Model.GstPercentage" />
                    </div>
                    <div class="col-md-3 gst-field">
                        <label>GST Value</label>
                        <input asp-for="GstValue" id="gstValue" type="text" readonly class="form-control" />
                    </div>
                </div>
                <div class="row justify-content-end">
                    <div class="col-md-3 tcs-field">
                        <label>TCS %</label>
                        <input asp-for="TcsPercentage" id="tcsPercentage" type="number" step="0.01" class="form-control" value="@Model.TcsPercentage" />
                    </div>
                    <div class="col-md-3 tcs-field">
                        <label>TCS Value</label>
                        <input asp-for="TcsValue" id="tcsValue" type="text" readonly class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Final Amount</label>
                    <input id="finalAmount" asp-for="FinalAmount" readonly class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        var products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        function addProductRow() {
            var index = $('#productTableBody tr').length;

            var options = `<option value="">-- Select Product --</option>`;
            products.forEach(p => {
                options += `<option value="${p.value}">${p.text}</option>`;
            });

            var row = `<tr>
                <td>${index + 1}</td>
                <td><select name="Items[${index}].ProductId" class="form-select product-select" data-index="${index}" required>${options}</select></td>
                <td><input type="number" step="0.01" name="Items[${index}].Weight" class="form-control weight" value="0" /></td>
                <td><input type="number" step="0.01" name="Items[${index}].Rate" class="form-control rate" /></td>
                <td><input type="text" class="form-control amount" name="Items[${index}].Amount" readonly /></td>
                <td><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">Delete</button></td>
            </tr>`;

            $('#productTableBody').append(row);
            updateFooterTotals();
        }

        function removeRow(button) {
            $(button).closest('tr').remove();
            updateRowNumbers();
            calculateFinalAmount();
            updateFooterTotals();
        }

        function updateRowNumbers() {
            $('#productTableBody tr').each(function (i) {
                $(this).find('td:first').text(i + 1);
                $(this).find('select, input').each(function () {
                    var name = $(this).attr('name');
                    if (name) {
                        var newName = name.replace(/\Items\[\d+\]/, `Items[${i}]`);
                        $(this).attr('name', newName);
                    }
                });
            });
        }

        $(document).on('change', '.product-select', function () {
            var selectedVal = $(this).val();
            var row = $(this).closest('tr');

            if (selectedVal) {
                $.get('/Invoices/GetProduct', { id: selectedVal }, function (data) {
                    row.find('.rate').val(data.rate);
                    calculateRowAmount(row);
                    calculateFinalAmount();
                });
            } else {
                row.find('.rate').val(0);
                calculateRowAmount(row);
                calculateFinalAmount();
            }
        });

        $(document).on('input', '.weight, .rate', function () {
            var row = $(this).closest('tr');
            calculateRowAmount(row);
            calculateFinalAmount();
        });

        $('#packagingCharge, #gstPercentage, #tcsPercentage, #withGstCheckbox').on('input change', calculateFinalAmount);


         $('#withGstCheckbox').on('change', function () {
            var checked = $(this).is(':checked');
            if (checked) {
                $('.gst-field').show();
                $('.tcs-field').show();
            } else {
                $('.gst-field').hide();
                $('.tcs-field').hide();
                $('#gstPercentage').val('');
                $('#gstValue').val('0.00');
                $('#tcsPercentage').val('');
                $('#tcsValue').val('0.00');
            }
            calculateFinalAmount();
        });

        function calculateRowAmount(row) {
            var weight = parseFloat(row.find('.weight').val()) || 0;
            var rate = parseFloat(row.find('.rate').val()) || 0;
            var amount = weight * rate;
            row.find('.amount').val(amount.toFixed(2));
            updateFooterTotals();
        }

        function calculateFinalAmount() {
            var total = 0;
            $('#productTableBody tr').each(function () {
                var amount = parseFloat($(this).find('.amount').val()) || 0;
                total += amount;
            });

            var packagingCharge = parseFloat($('#packagingCharge').val()) || 0;
            var base = total + packagingCharge;

            var withGst = $('#withGstCheckbox').is(':checked');
            var gstPercentage = parseFloat($('#gstPercentage').val()) || 0;
            var gstValue = 0;

            if (withGst && gstPercentage > 0) {
                gstValue = base * (gstPercentage / 100);
            } else {
                gstValue = 0;
            }
            $('#gstValue').val(gstValue.toFixed(2));
            base += gstValue;

            // TCS
            var tcsPercentage = parseFloat($('#tcsPercentage').val()) || 0;
            var tcsValue = 0;
            if (tcsPercentage > 0) {
                tcsValue = base * (tcsPercentage / 100);
            }
            $('#tcsValue').val(tcsValue.toFixed(2));
            base += tcsValue;

            $('#finalAmount').val(base.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        }

        function updateFooterTotals() {
            var totalWeight = 0;
            var totalAmount = 0;

            $('#productTableBody tr').each(function () {
                var weight = parseFloat($(this).find('.weight').val()) || 0;
                var amount = parseFloat($(this).find('.amount').val()) || 0;

                totalWeight += weight;
                totalAmount += amount;
            });

            $('#totalWeight').text(totalWeight.toFixed(2));
            $('#totalAmount').text(totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        }

        $(document).on('change', '#CustomerId', function () {
            var customerId = $(this).val();
            if (customerId) {
                $.get('/Invoices/GetCustomer', { id: customerId }, function (data) {
                    $('#Location').val(data.location);
                });
            } else {
                $('#Location').val('');
            }
        });

        $(document).ready(function () {
            $('#CustomerId').select2({
                theme: 'bootstrap-5',
                width: 'resolve'
            });

            if (!$('#withGstCheckbox').is(':checked')) {
                $('.gst-field').hide();
                $('.tcs-field').hide();
            }

            calculateFinalAmount();
            updateFooterTotals();
        });
    </script>
}
